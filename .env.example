# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# Public production origin used for canonical URLs, Open Graph URLs, the sitemap
# and robots.txt. No trailing slash. Never hardcode a domain in the source.
# Example: NEXT_PUBLIC_SITE_URL=https://your-domain.example
# When it is unset, no absolute URLs are emitted (the sitemap and robots.txt
# omit them instead of falling back to localhost).
NEXT_PUBLIC_SITE_URL=

# Resend API key. Server-side only — never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_EMAIL=

# Verified sender address in Resend, for example:
# RESEND_FROM_EMAIL="Portfolio <hello@your-verified-domain.com>"
RESEND_FROM_EMAIL=

# Optional: GitHub username for the stats endpoint (defaults to charan7769).
GITHUB_USERNAME=

# Optional: GitHub token, raises the API rate limit for the stats endpoint.
GITHUB_TOKEN=
